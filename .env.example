# Telegram bot token from @BotFather (required)
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Comma-separated Telegram user IDs allowed to use /admin, /broadcast, /ban and /unban
ADMIN_IDS=123456789

# Storage
DB_PATH=data/music_bot.db
AUDIO_DIR=data/audio

# Search behaviour
SEARCH_LIMIT=10
ITUNES_COUNTRY=US
REQUEST_TIMEOUT=20

# Audio cache
AUDIO_CACHE_TTL=86400
MAX_AUDIO_SIZE=20971520

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# HTTP health server port. Render sets PORT automatically; leave it unset locally.
# PORT=8080
